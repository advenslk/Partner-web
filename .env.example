# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies and CSRF tokens.
SESSION_SECRET="replace-with-a-strong-random-32-char-secret"

# SQLITE_DB_PATH: Optional custom path for SQLite database file (defaults to ./data/helzerx.sqlite).
SQLITE_DB_PATH="./data/helzerx.sqlite"

# UPLOAD_DIR: Private directory for uploaded partner documents outside public web root.
UPLOAD_DIR="./storage/private-uploads"

# SMTP Email Provider Configuration (optional - if omitted, emails are logged to internal outbox table)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HelzerX Partnerships <partnerships@helzerx.example>"

# Initial Super Admin Seed Credentials (override in production)
SEED_ADMIN_EMAIL="admin@helzerx.com"
SEED_ADMIN_PASSWORD="HelzerX!Admin2026"
